# Copy to backend/.env to override. All values are optional.

# Where Ollama is listening.
OLLAMA_HOST=http://localhost:11434

# Model used by both targets. Run `ollama pull <model>` first.
OLLAMA_MODEL=llama3.2:1b

# Per-request timeout for Ollama calls, in seconds.
OLLAMA_TIMEOUT_SECONDS=120

# Comma-separated origins allowed to call the API (the React dashboard).
CORS_ORIGINS=http://localhost:5173

# Benchmark data root (documents/, test_cases/, results/). Defaults to <repo>/data.
# DATA_DIR=/path/to/data
